[unix_http_server]
file=/home/cloud/deploy/supervisor.sock

[supervisord]
logfile=/home/cloud/deploy/logs/supervisord.log
logfile_maxbytes=50MB
logfile_backups=2
loglevel=info
pidfile=/home/cloud/deploy/supervisord.pid

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix:///home/cloud/deploy/supervisor.sock

[program:strata]
command=/home/cloud/Strata/run-iq3_xxs.sh
directory=/home/cloud/Strata
autostart=true
autorestart=true
startsecs=15
startretries=3
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=30
stdout_logfile=/home/cloud/deploy/logs/strata.out.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=3
stderr_logfile=/home/cloud/deploy/logs/strata.err.log
stderr_logfile_maxbytes=20MB
stderr_logfile_backups=3
environment=HF_ENDPOINT="https://hf-mirror.com"

# ---- 实验布局："每卡一个实例"（layout.sh dual 时才启动；autostart=false）----
[program:strata-a]
command=/home/cloud/Strata/run-iq3_xxs-a.sh
directory=/home/cloud/Strata
autostart=false
autorestart=true
startsecs=15
startretries=3
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=30
stdout_logfile=/home/cloud/deploy/logs/strata-a.out.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=3
stderr_logfile=/home/cloud/deploy/logs/strata-a.err.log
stderr_logfile_maxbytes=20MB
stderr_logfile_backups=3
environment=HF_ENDPOINT="https://hf-mirror.com"

[program:strata-b]
command=/home/cloud/Strata/run-iq3_xxs-b.sh
directory=/home/cloud/Strata
autostart=false
autorestart=true
startsecs=15
startretries=3
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=30
stdout_logfile=/home/cloud/deploy/logs/strata-b.out.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=3
stderr_logfile=/home/cloud/deploy/logs/strata-b.err.log
stderr_logfile_maxbytes=20MB
stderr_logfile_backups=3
environment=HF_ENDPOINT="https://hf-mirror.com"

[program:rag-proxy]
command=/home/cloud/Strata/.venv/bin/python /home/cloud/rag-proxy/rag_proxy.py --config /home/cloud/rag-proxy/config.json
directory=/home/cloud/rag-proxy
autostart=true
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=15
stdout_logfile=/home/cloud/deploy/logs/rag-proxy.out.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=2
stderr_logfile=/home/cloud/deploy/logs/rag-proxy.err.log
stderr_logfile_maxbytes=10MB
stderr_logfile_backups=2

[program:layout-restore]
command=/home/cloud/Strata/layout-restore.sh
autostart=true
autorestart=false
startsecs=0
startretries=1
stdout_logfile=/home/cloud/deploy/logs/layout-restore.log

[program:face-service]
command=/home/cloud/face-service/run.sh
directory=/home/cloud/face-service
autostart=true
autorestart=true
startsecs=10
startretries=3
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=20
stdout_logfile=/home/cloud/deploy/logs/face-service.out.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
stderr_logfile=/home/cloud/deploy/logs/face-service.err.log
stderr_logfile_maxbytes=10MB
stderr_logfile_backups=3

; [SSE 2026-10-26] DeepSeek-V4.1-Flash 试验通道（卡0+1 / 8092）。autostart=false：
; 只有 ds41_switch.sh（或手动 supervisorctl start）才拉起；Pod 重建也不会自动起它。
[program:strata-ds41]
command=/home/cloud/Strata/run-ds41.sh
directory=/home/cloud/Strata
autostart=false
autorestart=true
startsecs=15
startretries=3
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=120
stdout_logfile=/home/cloud/deploy/logs/ds41.out.log
stdout_logfile_maxbytes=20MB
stderr_logfile=/home/cloud/deploy/logs/ds41.err.log
stderr_logfile_maxbytes=20MB
environment=HOME="/home/cloud",USER="cloud"

; [SSE 2026-11-03] 胡桃 TTS 隧道：把邻居 pod 上已加载 run 122（胡桃）权重的
; GPT-SoVITS worker（127.0.0.1:9882）映射到本 Pod 的回环端口，网关 /tts/say 直接用它。
; 只做 SSH 端口转发，不改邻居的进程/权重；worker 挂了 supervisor 会重连。
[program:tts-tunnel]
command=/usr/bin/ssh -N -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -L 127.0.0.1:9882:127.0.0.1:9882 pod-tts
directory=/home/cloud
autostart=true
autorestart=true
startsecs=2
startretries=100
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=5
stdout_logfile=/home/cloud/deploy/logs/tts-tunnel.out.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=2
stderr_logfile=/home/cloud/deploy/logs/tts-tunnel.err.log
stderr_logfile_maxbytes=5MB
stderr_logfile_backups=2
environment=HOME="/home/cloud",USER="cloud"
